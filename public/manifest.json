{
  "manifest_version": 3,
  "name": "ProxyFlow",
  "version": "1.0.0",
  "description": "本地优先的 Chrome 独立代理与智能规则管理工具。",
  "minimum_chrome_version": "120",
  "permissions": ["proxy", "storage", "declarativeNetRequest", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ProxyFlow"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "optional_permissions": ["privacy"],
  "homepage_url": "https://github.com/ihatetheworld-ckl/ProxyFlow"
}
